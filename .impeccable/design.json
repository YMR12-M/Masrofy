  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action of a region.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>عملية جديدة</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;min-height:42px;padding:0 16px;border:0;border-radius:10px;background:#0e6a4c;color:#f6fbf8;font:500 15px \"Readex Pro Variable\",system-ui,sans-serif;cursor:pointer;box-shadow:0 1px 2px rgb(15 59 45 / 18%);transition:background-color .18s cubic-bezier(.16,1,.3,1),transform .12s}.ds-btn-primary:hover{background:#0b5a40}.ds-btn-primary:focus-visible{outline:2px solid #0e6a4c;outline-offset:2px}.ds-btn-primary:active{transform:scale(.97)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting actions.",
      "html": "<button class=\"ds-btn-secondary\">حفظ وإضافة غيرها</button>",
      "css": ".ds-btn-secondary{min-height:42px;padding:0 16px;border:1px solid #b9c7bd;border-radius:10px;background:#fbfcfa;color:#13221c;font:500 15px \"Readex Pro Variable\",system-ui,sans-serif;cursor:pointer}.ds-btn-secondary:hover{background:#f3f6f2;border-color:#5d6d65}.ds-btn-secondary:focus-visible{outline:2px solid #0e6a4c;outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label above, hint or error below.",
      "html": "<label class=\"ds-field\" dir=\"rtl\"><span>فين / لمين؟</span><input placeholder=\"مثلًا: كارفور\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font:500 14px \"Readex Pro Variable\",system-ui,sans-serif;color:#13221c}.ds-field input{min-height:44px;padding:10px 12px;border:1px solid #b9c7bd;border-radius:10px;background:#fbfcfa;font:400 15px \"Readex Pro Variable\",system-ui,sans-serif}.ds-field input:hover{border-color:#5d6d65}.ds-field input:focus{outline:none;border-color:#0e6a4c;box-shadow:0 0 0 3px rgb(14 106 76 / 22%)}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-rail",
      "description": "Desktop ink rail; active item gets a light wash and a gold icon.",
      "html": "<nav class=\"ds-rail\" dir=\"rtl\"><a class=\"on\" href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 10.5 12 3l9 7.5\"/><path d=\"M5 9.5V21h14V9.5\"/></svg>الرئيسية</a><a href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M9 6h12M9 12h12M9 18h12\"/></svg>العمليات</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:248px;padding:14px;background:#0f3b2d}.ds-rail a{display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 12px;border-radius:10px;color:#a6c2b4;text-decoration:none;font:500 15px \"Readex Pro Variable\",system-ui,sans-serif}.ds-rail a:hover{background:rgb(255 255 255 / 6%);color:#eef5ef}.ds-rail a.on{background:rgb(255 255 255 / 10%);color:#eef5ef;font-weight:600}.ds-rail a.on svg{color:#e2bb55}"
    },
    {
      "name": "Plate",
      "kind": "card",
      "refersTo": "plate",
      "description": "One reversed plate per screen for its key figure.",
      "html": "<section class=\"ds-plate\" dir=\"rtl\"><span class=\"lbl\">المتبقّي من الشهر</span><span class=\"fig\"><span class=\"amt\">9,489<small>.50</small></span><span class=\"cur\">ج.م.</span></span><span class=\"row\">دخل <b>26,500 ج.م.</b> · مصروف <b>17,010.50 ج.م.</b></span></section>",
      "css": ".ds-plate{position:relative;display:flex;flex-direction:column;gap:6px;padding:26px 30px;border-radius:20px;color:#eef5ef;background:radial-gradient(120% 160% at 100% 0%,#16503d 0%,#0f3b2d 58%);box-shadow:0 1px 2px rgb(15 59 45 / 6%),0 8px 24px -8px rgb(15 59 45 / 14%);font-family:\"Readex Pro Variable\",system-ui,sans-serif}.ds-plate::after{content:\"\";position:absolute;inset:7px;border:1px solid rgb(238 245 239 / 14%);border-radius:14px;pointer-events:none}.ds-plate .lbl{font-size:14px;color:#a6c2b4}.ds-plate .fig{display:inline-flex;align-items:baseline;gap:.3em;font-size:52px;line-height:1}.ds-plate .amt{direction:ltr;font-weight:650;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-plate small{font-size:.42em;font-weight:500;opacity:.8}.ds-plate .cur{font-size:.34em;opacity:.8}.ds-plate .row{font-size:14px;color:#a6c2b4;margin-top:10px}.ds-plate b{color:#eef5ef}"
    },
    {
      "name": "Coin Button",
      "kind": "custom",
      "refersTo": "coin-button",
      "description": "Phone add action in the tab bar: flat gold, one engraved ring.",
      "html": "<div class=\"ds-coin-bar\"><button class=\"ds-coin\" aria-label=\"عملية جديدة\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button></div>",
      "css": ".ds-coin-bar{display:grid;place-items:center;height:64px;padding-top:26px;background:#0f3b2d}.ds-coin{position:relative;width:60px;height:60px;margin-top:-52px;border:0;border-radius:50%;display:grid;place-items:center;background:#e2bb55;color:#0f3b2d;cursor:pointer;box-shadow:0 0 0 4px #0f3b2d,0 10px 22px -8px rgb(0 0 0 / 55%);transition:transform .16s}.ds-coin::after{content:\"\";position:absolute;width:46px;height:46px;border-radius:50%;border:1px solid rgb(15 59 45 / 40%)}.ds-coin:active{transform:scale(.93)}.ds-coin:focus-visible{outline:2px solid #eef5ef;outline-offset:5px}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Pill badges for status, always with a word.",
      "html": "<span class=\"ds-badge ok\">في الأمان</span> <span class=\"ds-badge over\">عدّت الحدّ</span>",
      "css": ".ds-badge{display:inline-flex;padding:2px 9px;border-radius:99px;font:500 12.5px \"Readex Pro Variable\",system-ui,sans-serif;background:#e3e9e3;color:#4a5c54}.ds-badge.ok{background:#ddefe4;color:#0f7a4f}.ds-badge.over{background:#f9e2df;color:#b02a1c}"
    }
