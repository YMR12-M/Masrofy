# ═══════════════════════════════════════════════════════════════
#  مصروفي — إعدادات السيرفر
#  انسخ هذا الملف إلى `.env` ثم عدّل القيم:   cp .env.example .env
#  كل متغيّر موثّق هنا. أي إعداد ناقص أو خطير في الإنتاج بيوقّف السيرفر
#  عند الإقلاع برسالة واضحة (config/env.js).
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4020
API_PREFIX=/api/v1

# ── العناوين ────────────────────────────────────────────────────
# النطاقات المسموح لها تكلّم الـ API (مفصولة بفاصلة).
# لوحة الويب 5190 · تطبيق الموبايل 5191 · Electron: app://masrofy · Capacitor: capacitor://localhost,http://localhost
CLIENT_ORIGIN=http://localhost:5190,http://localhost:5191
# عنوان الواجهة كما يراه الناس (بيدخل في روابط البريد)
APP_URL=http://localhost:5190

# ── قاعدة البيانات (MySQL 8+) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=masrofy
# قاعدة الاختبارات لازم تنتهي بـ _test — الاختبارات بتمسح بياناتها
DB_NAME_TEST=masrofy_test
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ── الجلسات والتوكنات ───────────────────────────────────────────
# ولّد السرّ بـ:   openssl rand -base64 48   (32 حرفًا على الأقل في الإنتاج)
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production
JWT_ACCESS_TTL=15m
# مدّة التجديد للمتصفّح، وللتطبيقات (موبايل/ديسكتوب)
JWT_REFRESH_TTL=30d
JWT_REFRESH_TTL_APP=90d
BCRYPT_ROUNDS=12
# بعد كم محاولة دخول فاشلة يتقفل الحساب، ولمدّة كم دقيقة
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# كوكي التجديد (للمتصفّح). في الإنتاج: COOKIE_SECURE=true
COOKIE_SECURE=false
# Lax لو الواجهة والـ API على نفس الموقع، وNone لو على نطاقين مختلفين (يتطلّب COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ── التسجيل ─────────────────────────────────────────────────────
# أي حد يقدر يفتح حساب أسرة جديد من شاشة «حساب جديد».
# اقفله (false) لو النشر خاص بأسرة واحدة، وأنشئ الحساب الأول بـ npm run db:bootstrap
ALLOW_SIGNUP=true

# ── البريد (SMTP) ───────────────────────────────────────────────
# لو SMTP_HOST فاضي في التطوير: الرسائل بتتطبع في اللوج بدل ما تتبعت.
# في الإنتاج لازم SMTP أو MAIL_DISABLED=true صراحةً.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=مصروفي <no-reply@example.com>
MAIL_DISABLED=false

# ── أوّل تشغيل (db:bootstrap) — فقط لو ALLOW_SIGNUP=false ───────
# تُقرأ مرّة واحدة لإنشاء الأسرة وحساب صاحبها، ثم احذف ADMIN_PASSWORD من الملف.
HOUSEHOLD_NAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
